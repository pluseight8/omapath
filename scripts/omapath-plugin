#!/usr/bin/env bash
set -euo pipefail

# The only supported installation surface is the official Omarchy plugin
# lifecycle. Omarchy owns the git checkout, manifest validation, enable state
# and shell reload; this helper provides stable non-interactive wrappers.

readonly PLUGIN_ID="io.github.pluseight8.omapath"
readonly REPOSITORY_URL="https://github.com/pluseight8/omapath.git"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
DRY_RUN=0

usage() {
  cat <<'USAGE'
Usage: scripts/omapath-plugin <command> [--dry-run]

Commands:
  install   Add the public repository, enable its service, and create a launcher entry
  update    Update the installed plugin checkout and refresh the launcher entry
  remove    Remove the launcher entry and installed plugin checkout
  validate  Validate the local plugin checkout

The lifecycle commands use the official `omarchy plugin` subcommands.
The service-only plugin has no Omarchy bar widget. Its service creates the
user-local .desktop file used by the normal application launcher.
`--dry-run` prints the command without changing state.
USAGE
}

die() {
  echo "omapath-plugin: $*" >&2
  exit 1
}

require_omarchy() {
  (( DRY_RUN )) && return 0
  command -v omarchy >/dev/null 2>&1 || die "the Omarchy command was not found"
}

run_omarchy() {
  if (( DRY_RUN )); then
    printf 'dry-run:'
    printf ' %q' omarchy "$@"
    printf '\n'
    return 0
  fi
  omarchy "$@"
}

installed_plugin_dir() {
  printf '%s\n' "${HOME:?}/.config/omarchy/plugins/$PLUGIN_ID"
}

desktop_helper() {
  local helper="$(installed_plugin_dir)/scripts/desktop-entry.sh"
  if (( DRY_RUN )); then
    printf 'dry-run: desktop-entry %q\n' "$1"
    return 0
  fi
  [[ -x "$helper" ]] || die "installed plugin is missing its desktop-entry helper: $helper"
  "$helper" "$1"
}

install_plugin() {
  require_omarchy
  run_omarchy plugin add "$REPOSITORY_URL" --enable --yes
  desktop_helper install
}

update_plugin() {
  require_omarchy
  run_omarchy plugin update "$PLUGIN_ID" --yes
  desktop_helper install
}

remove_plugin() {
  local helper="$(installed_plugin_dir)/scripts/desktop-entry.sh"
  if (( DRY_RUN )); then
    desktop_helper remove
  elif [[ -x "$helper" ]]; then
    "$helper" remove
  elif [[ -x "$PROJECT_DIR/scripts/desktop-entry.sh" ]]; then
    # The marker check in the helper makes this fallback safe when the
    # checkout has already disappeared but the user launcher remains.
    "$PROJECT_DIR/scripts/desktop-entry.sh" remove
  fi
  require_omarchy
  run_omarchy plugin remove "$PLUGIN_ID" --yes
}

validate_plugin() {
  if (( DRY_RUN )); then
    printf 'dry-run: validate %s\n' "$PROJECT_DIR"
    return 0
  fi
  if command -v omarchy >/dev/null 2>&1; then
    omarchy plugin validate "$PROJECT_DIR"
  else
    python3 "$PROJECT_DIR/scripts/validate_plugin.py" "$PROJECT_DIR"
  fi
}

command_name="${1:-}"
if [[ -n "$command_name" ]]; then
  shift
fi
while (($#)); do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
  shift
done

case "$command_name" in
  install) install_plugin ;;
  update) update_plugin ;;
  remove|uninstall) remove_plugin ;;
  validate) validate_plugin ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
