# Omapath remains pre-1.0 until the real Omarchy release gates pass.
pkgname=omapath
pkgver=0.2.0
pkgrel=1
pkgdesc='Native GTK4 file manager for Omarchy'
arch=('any')
url='https://github.com/pluseight8/omapath'
license=('MIT')
depends=('gtk4' 'python' 'python-gobject')
makedepends=('python-build' 'python-installer')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 data/dev.omarchy.Omapath.desktop \
    "${pkgdir}/usr/share/applications/dev.omarchy.Omapath.desktop"
  install -Dm644 data/dev.omarchy.Omapath.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/dev.omarchy.Omapath.metainfo.xml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
